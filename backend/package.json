{
  "name": "tessera-api",
  "version": "0.2.0",
  "private": true,
  "description": "Tessera Health API: Phase 2 security core (auth + MFA, roles, care relationships, encrypted identifiers, append-only audit, break-the-glass).",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "db:start": "sh scripts/db.sh start",
    "db:stop": "sh scripts/db.sh stop",
    "db:reset": "sh scripts/db.sh reset",
    "migrate": "node --experimental-strip-types --no-warnings src/migrate.ts",
    "seed": "node --experimental-strip-types --no-warnings src/seed.ts",
    "dev": "node --experimental-strip-types --no-warnings src/server.ts",
    "totp": "node --experimental-strip-types --no-warnings src/devtotp.ts",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=1 test/*.test.ts",
    "backup": "node --experimental-strip-types --no-warnings src/backup.ts",
    "drill": "node --experimental-strip-types --no-warnings src/backup.ts drill",
    "rotate-kek": "node --experimental-strip-types --no-warnings src/rotate-kek.ts",
    "audit:checkpoint": "node --experimental-strip-types --no-warnings src/audit-cli.ts checkpoint",
    "audit:verify": "node --experimental-strip-types --no-warnings src/audit-cli.ts verify",
    "loadtest": "node --experimental-strip-types --no-warnings scripts/loadtest.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  }
}